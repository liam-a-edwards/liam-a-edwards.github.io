---
layout: default
---
{%- comment -%}
  Local override of al_folio_core 1.0.15 _layouts/cv.liquid.
  Adds CSS the CV plugin expects from Bootstrap (disabled on this site):
  without it, every CV entry shows a stray list bullet next to its date badge.
{%- endcomment -%}
<style>
  .cv ul.list-group {
    list-style: none;
    padding-left: 0;
    margin-bottom: 0;
  }
  .cv .list-group-item {
    padding: 0.75rem 0;
    border: none !important;
  }
  /* The date/location column is a small table; drop the generic table borders */
  .cv table.table-cv,
  .cv table.table-cv tr,
  .cv table.table-cv td,
  .cv table.table-cv th {
    border: none !important;
  }
  /*
    Fixed-width date column. The plugin's 2/12 column is narrower than
    "Los Angeles, CA", so the inner table grew to fit its text and every
    entry ended up a different width. Also cancels the Bootstrap-era
    .date-column offset that only Experience/Education get.
  */
  .cv .list-group-item > .row {
    flex-wrap: nowrap;
    margin-left: 0;
    margin-right: 0;
  }
  .cv .list-group-item > .row > .text-center {
    flex: 0 0 7.5rem;
    max-width: 7.5rem;
    width: 7.5rem;
    padding: 0;
    transform: none;
  }
  .cv .list-group-item > .row > .text-center + div {
    flex: 1 1 0;
    max-width: none;
    min-width: 0;
    padding: 0 0 0 0.5rem;
  }
  /*
    The text column has the plugin's mt-2 (0.5rem), which Tailwind's layered
    !important utility won't let us override, so drop the date column by the
    same amount to keep badge and title on one line.
  */
  .cv .list-group-item > .row > .text-center {
    padding-top: 0.5rem;
  }
  .cv .text-center > table.table-cv,
  .cv .text-center > table.table-cv tbody,
  .cv .text-center > table.table-cv tr,
  .cv .text-center > table.table-cv td {
    display: block;
    width: 100%;
    text-align: center;
  }
  .cv .text-center > table.table-cv p.location {
    margin: 0.25rem 0 0;
  }
  /* Same-width badges */
  .cv .text-center > table.table-cv .badge {
    display: block;
    width: 100%;
    min-width: 0 !important;
    box-sizing: border-box;
    padding: 0.3em 0.25em;
  }
  /* Phones: date + location on one line above the entry */
  @media (max-width: 575.98px) {
    .cv .list-group-item > .row {
      flex-wrap: wrap;
    }
    .cv .list-group-item > .row > .text-center {
      flex: 0 0 100%;
      max-width: 100%;
      width: 100%;
      margin-bottom: 0;
      padding-top: 0;
    }
    .cv .list-group-item > .row > .text-center + div {
      flex: 0 0 100%;
      padding: 0;
    }
    .cv .text-center > table.table-cv tbody {
      display: flex;
      align-items: center;
      gap: 0.75rem;
    }
    .cv .text-center > table.table-cv tr,
    .cv .text-center > table.table-cv td {
      width: auto;
    }
    .cv .text-center > table.table-cv .badge {
      width: 7.5rem;
    }
    .cv .text-center > table.table-cv p.location {
      margin: 0;
    }
  }
</style>
{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
